# このファイルをコピーして .env を作成し、実際の値を入れる。
# .env は .gitignore によりコミットされない。
#
# ⚠️ Phase 1 では、フロントエンド（Vite）が読めるよう VITE_ プレフィックスを付けている。
#    VITE_ 付きの値はビルド成果物に埋め込まれるため、配布ビルドでは使わないこと。
#    Phase 2 で、キーは OS のセキュアストレージに移し Rust 側からのみ参照する。

# --- LLM プロバイダ ---
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_GEMINI_API_KEY=

# --- SEC EDGAR ---
# SEC は User-Agent に連絡先の明示を要求する（例: "StockAnalyzer your.name@example.com"）
SEC_USER_AGENT=

# --- Yahoo Finance ---
# 公式 API を使う場合のキー（非公式ライブラリ利用時は不要）
YAHOO_FINANCE_API_KEY=
