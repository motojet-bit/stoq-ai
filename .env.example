# このファイルをコピーして .env を作成し、実際の値を入れる。
# .env は .gitignore によりコミットされない。

# --- LLM ---
# Anthropic Claude API キー
ANTHROPIC_API_KEY=

# --- SEC EDGAR ---
# SEC は User-Agent に連絡先の明示を要求する（例: "StockAnalyzer your.name@example.com"）
SEC_USER_AGENT=

# --- Yahoo Finance ---
# 公式 API を使う場合のキー（非公式ライブラリ利用時は不要）
YAHOO_FINANCE_API_KEY=
